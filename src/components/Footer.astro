---
import { NAV_LINKS, PORTAL_LINKS, SITE, whatsappLink } from "@/data/site";
---

<footer class="mt-24 px-3 pb-6 sm:px-6">
  <div class="glass mx-auto max-w-6xl rounded-3xl p-6 sm:p-10">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <div class="flex items-center gap-2">
          <span class="grid h-9 w-9 place-items-center rounded-full bg-gradient-to-br from-carrot-400 to-leaf-500 text-lg">
            🥕
          </span>
          <span class="font-semibold text-carrot-50">{SITE.name}</span>
        </div>
        <p class="mt-3 text-sm text-carrot-50/70">{SITE.tagline}</p>
        <div class="mt-4 flex gap-2">
          <a
            href={SITE.social.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="glass glass-card rounded-full px-3 py-1.5 text-xs text-carrot-50/80"
            >Instagram</a
          >
          <a
            href={SITE.social.facebook}
            target="_blank"
            rel="noopener noreferrer"
            class="glass glass-card rounded-full px-3 py-1.5 text-xs text-carrot-50/80"
            >Facebook</a
          >
        </div>
      </div>

      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-carrot-300">Explora</p>
        <ul class="mt-3 space-y-2 text-sm text-carrot-50/75">
          {NAV_LINKS.map((link) => (
            <li><a href={link.href} class="hover:text-carrot-200">{link.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-carrot-300">Portal interno</p>
        <ul class="mt-3 space-y-2 text-sm text-carrot-50/75">
          {PORTAL_LINKS.map((link) => (
            <li><a href={link.href} class="hover:text-carrot-200">{link.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-carrot-300">Visítanos</p>
        <ul class="mt-3 space-y-2 text-sm text-carrot-50/75">
          <li>{SITE.address}</li>
          <li>{SITE.city}, {SITE.state}, {SITE.country}</li>
          <li>
            <a href={`tel:+${SITE.phoneE164}`} class="hover:text-carrot-200">{SITE.phoneDisplay}</a>
          </li>
          <li>
            <a href={whatsappLink("¡Hola! Tengo una pregunta")} class="hover:text-carrot-200">WhatsApp</a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-8 flex flex-col gap-2 border-t border-carrot-50/10 pt-6 text-xs text-carrot-50/50 sm:flex-row sm:items-center sm:justify-between">
      <p>© {new Date().getFullYear()} {SITE.name}. Demo funcional con datos de ejemplo.</p>
      <p>Hecho con 🥕 en {SITE.city}, {SITE.state}</p>
    </div>
  </div>
</footer>
