---
import Layout from "@/layouts/Layout.astro";
import MayoreoForm from "@/components/islands/MayoreoForm";
---

<Layout title="Pedidos de mayoreo" description="Cotiza pedidos por volumen para eventos, oficinas y negocios.">
  <header class="mb-10">
    <span class="glass inline-flex items-center gap-2 rounded-full px-3 py-1 text-xs font-medium text-carrot-200">
      📦 Mayoreo
    </span>
    <h1 class="mt-4 text-3xl font-bold sm:text-5xl">Pedidos por volumen</h1>
    <p class="mt-3 max-w-2xl text-sm text-carrot-50/70 sm:text-base">
      Ideal para oficinas, eventos y catering. Elige el producto y la cantidad para ver tu cotización automática al
      instante.
    </p>
  </header>

  <MayoreoForm client:load />
</Layout>
