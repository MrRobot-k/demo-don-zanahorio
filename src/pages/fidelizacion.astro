---
import Layout from "@/layouts/Layout.astro";
import LoyaltyDashboard from "@/components/islands/LoyaltyDashboard";
---

<Layout title="Fidelización" description="Programa de puntos, monedero electrónico, gift cards y código QR.">
  <header class="mb-10">
    <span class="glass inline-flex items-center gap-2 rounded-full px-3 py-1 text-xs font-medium text-carrot-200">
      💳 Fidelización
    </span>
    <h1 class="mt-4 text-3xl font-bold sm:text-5xl">Tu monedero Don Zanahorio</h1>
    <p class="mt-3 max-w-2xl text-sm text-carrot-50/70 sm:text-base">
      Acumula mínimo 10% de cada compra en puntos, guarda saldo en tu monedero digital y valida todo con tu código
      QR personal.
    </p>
  </header>

  <LoyaltyDashboard client:load />
</Layout>
