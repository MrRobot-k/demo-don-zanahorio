---
import Layout from "@/layouts/Layout.astro";
import CategoriesGrid from "@/components/islands/CategoriesGrid";
import { SITE, whatsappLink } from "@/data/site";
import { TESTIMONIALS } from "@/data/team";

const modules = [
  {
    emoji: "🛒",
    title: "Menú y pedidos en línea",
    description: "Catálogo digital completo, carrito, entrega a domicilio o para recoger, y pedidos de mayoreo.",
    href: "/menu",
    cta: "Ver menú",
  },
  {
    emoji: "💳",
    title: "Fidelización y monedero",
    description: "Puntos, monedero electrónico, gift cards y validación con código QR.",
    href: "/fidelizacion",
    cta: "Conocer beneficios",
  },
  {
    emoji: "🏷️",
    title: "Promociones inteligentes",
    description: "Cupones automáticos, descuentos exclusivos web y productos destacados.",
    href: "/promociones",
    cta: "Ver promociones",
  },
  {
    emoji: "🧑‍🍳",
    title: "Portal interno del equipo",
    description: "POS táctil, control de comandas, inventario y capacitación del personal.",
    href: "/pos",
    cta: "Ver portal interno",
  },
];

const steps = [
  { n: "1", title: "Elige tus platillos", text: "Explora el menú digital por categorías y arma tu pedido." },
  { n: "2", title: "Recoge o recibe a domicilio", text: "Calculamos el costo de envío automáticamente según tu zona." },
  { n: "3", title: "Gana puntos y beneficios", text: "Cada compra suma a tu monedero y desbloquea recompensas." },
];
---

<Layout title="Inicio" description="Menú digital, pedidos en línea, fidelización y más en Don Zanahorio, Ciudad Victoria.">
  <section class="glass-strong relative overflow-hidden rounded-[2rem] px-6 py-14 sm:px-14 sm:py-20">
    <div class="relative z-10 max-w-2xl">
      <span class="glass inline-flex items-center gap-2 rounded-full px-3 py-1 text-xs font-medium text-carrot-200">
        📍 {SITE.city}, {SITE.state}
      </span>
      <h1 class="mt-5 text-4xl font-bold leading-tight tracking-tight sm:text-6xl">
        Sabor <span class="text-gradient">casero</span> que se nota en cada bocado
      </h1>
      <p class="mt-5 text-base text-carrot-50/75 sm:text-lg">
        {SITE.tagline}. Pide en línea, recoge en tienda o recibe a domicilio — y acumula
        recompensas en cada visita.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="/menu"
          class="rounded-full bg-carrot-500 px-6 py-3 text-sm font-semibold text-ink-950 shadow-glass-lg transition hover:bg-carrot-400"
        >
          Ver el menú
        </a>
        <a
          href={whatsappLink("¡Hola! Quiero hacer un pedido en Don Zanahorio 🥕")}
          target="_blank"
          rel="noopener noreferrer"
          class="glass glass-card rounded-full px-6 py-3 text-sm font-semibold text-carrot-50"
        >
          Pedir por WhatsApp
        </a>
      </div>
      <div class="mt-10 flex flex-wrap gap-2 text-xs text-carrot-50/70">
        <span class="glass rounded-full px-3 py-1.5">🚚 Envío a domicilio</span>
        <span class="glass rounded-full px-3 py-1.5">🏬 Recoge en tienda</span>
        <span class="glass rounded-full px-3 py-1.5">⭐ Programa de puntos 10%+</span>
        <span class="glass rounded-full px-3 py-1.5">📦 Pedidos de mayoreo</span>
      </div>
    </div>

    <div class="pointer-events-none absolute -right-10 -top-10 hidden text-[16rem] leading-none opacity-20 sm:block">
      🥕
    </div>
  </section>

  <section class="mt-16">
    <div class="flex items-end justify-between gap-4">
      <h2 class="text-2xl font-bold sm:text-3xl">Todo lo que necesita tu restaurante</h2>
    </div>
    <p class="mt-2 max-w-2xl text-sm text-carrot-50/70">
      Una plataforma integrada: portal público, fidelización, promociones y sistema interno para tu equipo.
    </p>
    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {modules.map((m) => (
        <a href={m.href} class="glass glass-card flex flex-col rounded-2xl p-6">
          <span class="text-3xl">{m.emoji}</span>
          <h3 class="mt-4 text-lg font-semibold">{m.title}</h3>
          <p class="mt-2 flex-1 text-sm text-carrot-50/70">{m.description}</p>
          <span class="mt-4 text-sm font-semibold text-carrot-300">{m.cta} →</span>
        </a>
      ))}
    </div>
  </section>

  <section class="mt-20">
    <div class="flex items-end justify-between gap-4">
      <h2 class="text-2xl font-bold sm:text-3xl">Explora nuestro menú por categoría</h2>
      <a href="/menu" class="text-sm font-semibold text-carrot-300 hover:text-carrot-200">Ver menú completo →</a>
    </div>
    <CategoriesGrid client:visible />
  </section>

  <section class="mt-20 grid gap-5 lg:grid-cols-3">
    {steps.map((s) => (
      <div class="glass rounded-2xl p-6">
        <span class="grid h-10 w-10 place-items-center rounded-full bg-carrot-500/20 font-bold text-carrot-300">
          {s.n}
        </span>
        <h3 class="mt-4 font-semibold">{s.title}</h3>
        <p class="mt-1 text-sm text-carrot-50/70">{s.text}</p>
      </div>
    ))}
  </section>

  <section class="mt-20">
    <h2 class="text-2xl font-bold sm:text-3xl">Lo que dicen nuestros clientes</h2>
    <div class="mt-8 grid gap-5 sm:grid-cols-3">
      {TESTIMONIALS.map((t) => (
        <div class="glass rounded-2xl p-6">
          <div class="text-carrot-300">{"★".repeat(t.rating)}{"☆".repeat(5 - t.rating)}</div>
          <p class="mt-3 text-sm text-carrot-50/80">“{t.quote}”</p>
          <p class="mt-4 text-xs font-semibold text-carrot-50/60">{t.name}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="glass-strong mt-20 rounded-[2rem] px-6 py-12 text-center sm:px-14">
    <h2 class="text-2xl font-bold sm:text-3xl">¿Listo para probar Don Zanahorio?</h2>
    <p class="mx-auto mt-3 max-w-xl text-sm text-carrot-50/70">
      Haz tu pedido en línea o visítanos en {SITE.address}, {SITE.city}, {SITE.state}.
    </p>
    <div class="mt-7 flex flex-wrap justify-center gap-3">
      <a href="/menu" class="rounded-full bg-carrot-500 px-6 py-3 text-sm font-semibold text-ink-950 shadow-glass-lg hover:bg-carrot-400">
        Ordenar ahora
      </a>
      <a href="/fidelizacion" class="glass glass-card rounded-full px-6 py-3 text-sm font-semibold text-carrot-50">
        Únete a fidelización
      </a>
    </div>
  </section>
</Layout>
