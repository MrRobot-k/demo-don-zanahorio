          <h3 class="mt-4 text-lg font-semibold">{m.title}</h3>
          <p class="mt-2 flex-1 text-sm text-carrot-50/70">{m.description}</p>
          <span class="mt-4 text-sm font-semibold text-carrot-300">{m.cta} →</span>
        </a>
      ))}
    </div>
  </section>

  <section class="mt-20">
    <div class="flex items-end justify-between gap-4">
      <h2 class="text-2xl font-bold sm:text-3xl">Los favoritos de la casa</h2>
      <a href="/menu" class="text-sm font-semibold text-carrot-300 hover:text-carrot-200">Ver menú completo →</a>
    </div>
    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {bestsellers.map((p) => p && (
        <div class="glass glass-card rounded-2xl p-5">
          <span class="text-4xl">{p.emoji}</span>
          <h3 class="mt-3 font-semibold">{p.name}</h3>
          <p class="mt-1 text-xs text-carrot-50/65">{p.description}</p>
          <p class="mt-3 font-bold text-carrot-200">${p.price} MXN</p>
        </div>
      ))}
    </div>
  </section>

  <section class="mt-20 grid gap-5 lg:grid-cols-3">
    {steps.map((s) => (
      <div class="glass rounded-2xl p-6">
        <span class="grid h-10 w-10 place-items-center rounded-full bg-carrot-500/20 font-bold text-carrot-300">
          {s.n}
        </span>
        <h3 class="mt-4 font-semibold">{s.title}</h3>
        <p class="mt-1 text-sm text-carrot-50/70">{s.text}</p>
      </div>
    ))}
  </section>

  <section class="mt-20">
    <h2 class="text-2xl font-bold sm:text-3xl">Lo que dicen nuestros clientes</h2>
    <div class="mt-8 grid gap-5 sm:grid-cols-3">
      {TESTIMONIALS.map((t) => (
        <div class="glass rounded-2xl p-6">
          <div class="text-carrot-300">{"★".repeat(t.rating)}{"☆".repeat(5 - t.rating)}</div>
          <p class="mt-3 text-sm text-carrot-50/80">“{t.quote}”</p>
          <p class="mt-4 text-xs font-semibold text-carrot-50/60">{t.name}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="glass-strong mt-20 rounded-[2rem] px-6 py-12 text-center sm:px-14">
    <h2 class="text-2xl font-bold sm:text-3xl">¿Listo para probar Don Zanahorio?</h2>
    <p class="mx-auto mt-3 max-w-xl text-sm text-carrot-50/70">
      Haz tu pedido en línea o visítanos en {SITE.address}, {SITE.city}, {SITE.state}.
    </p>
    <div class="mt-7 flex flex-wrap justify-center gap-3">
      <a href="/menu" class="rounded-full bg-carrot-500 px-6 py-3 text-sm font-semibold text-ink-950 shadow-glass-lg hover:bg-carrot-400">
        Ordenar ahora
      </a>
      <a href="/fidelizacion" class="glass glass-card rounded-full px-6 py-3 text-sm font-semibold text-carrot-50">
        Únete a fidelización
      </a>
    </div>
  </section>
</Layout>
