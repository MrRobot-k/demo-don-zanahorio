          experiencia también en Google y recibe un cupón especial.
        </p>
        <a
          href={SITE.googleReviewUrl}
          target="_blank"
          rel="noopener noreferrer"
          className="mt-6 inline-block rounded-full bg-carrot-500 px-6 py-3 text-sm font-semibold text-ink-950 hover:bg-carrot-400"
        >
          Dejar reseña en Google
        </a>
      </div>
    );
  }

  return (
    <form
      className="glass mx-auto max-w-xl space-y-7 rounded-2xl p-6 sm:p-8"
